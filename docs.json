{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "EPAdossier Klant-API",
  "description": "De API voor klanten en samenwerkingspartners van een kantoor dat met EPAdossier werkt: aanvragen insturen, de stand volgen, het dossier ophalen en documenten uploaden.",
  "colors": {
    "primary": "#0b4f4a",
    "light": "#7ccf00",
    "dark": "#0b4f4a"
  },
  "background": {
    "color": {
      "light": "#f9f8f7",
      "dark": "#0c0d10"
    }
  },
  "fonts": {
    "family": "Satoshi",
    "source": "https://cdn.fontshare.com/wf/NWBQYJIM7GCZ5XWD7D26ARB3VDY55ZRT/K63EV2KZIGKLE7RANQ2U42S6SVHU5RJ7/X6XYTKIVDUW7GZTZPZNN4EUM5KH54KHF.woff2",
    "format": "woff2"
  },
  "icons": {
    "library": "lucide"
  },
  "appearance": {
    "default": "system"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Handleiding",
        "groups": [
          {
            "group": "Aan de slag",
            "pages": [
              "index",
              "sleutel",
              "omgevingen"
            ]
          },
          {
            "group": "Werken met de API",
            "pages": [
              "aanvraag-insturen",
              "aanvragen-volgen",
              "dossier-ophalen",
              "documenten-uploaden"
            ]
          },
          {
            "group": "Naslag",
            "pages": [
              "fouten-en-limieten"
            ]
          }
        ]
      },
      {
        "tab": "API-referentie",
        "groups": [
          {
            "group": "Endpoints",
            "openapi": "openapi.yaml"
          }
        ]
      }
    ]
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python",
        "php"
      ]
    }
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Naar EPAdossier",
      "href": "https://epadossier.nl"
    }
  },
  "footer": {
    "socials": {
      "website": "https://epadossier.nl"
    }
  }
}
